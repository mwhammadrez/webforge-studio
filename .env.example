# WebForge Studio — optional environment overrides.
# Never commit real secrets. The DeepSeek key can also be entered in Settings,
# where it is encrypted with the operating system's credential storage.

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GITHUB_TOKEN=
# WEBFORGE_DATA_DIR=
# WEBFORGE_PROJECTS_DIR=
# WEBFORGE_PORT_RANGE_START=5173
# WEBFORGE_PORT_RANGE_END=5273
# Test only: allow loopback/private URLs during integration tests.
# WEBFORGE_ALLOW_PRIVATE=0
