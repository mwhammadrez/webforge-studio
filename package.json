{
  "name": "webforge-studio",
  "version": "1.2.1",
  "description": "WebForge Studio — استودیوی استخراج، ویرایش و ساخت سایت",
  "main": "./out/main/index.js",
  "author": "WebForge",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:placeholders": "node scripts/check-no-placeholders.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:placeholders && npm run build",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:linux": "npm run build && electron-builder --linux AppImage dir",
    "package:dir": "npm run build && electron-builder --dir",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axe-core": "^4.14.0",
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.3",
    "mime-types": "^3.0.1",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "studio.webforge.app",
    "productName": "WebForge Studio",
    "copyright": "WebForge Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/kits",
        "to": "resources/kits"
      },
      {
        "from": "resources/skills",
        "to": "resources/skills"
      },
      {
        "from": "resources/fonts",
        "to": "resources/fonts"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "icon.png"
      },
      {
        "from": "node_modules/axe-core/axe.min.js",
        "to": "axe.min.js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebForge Studio",
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Development",
      "icon": "resources/icons/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
